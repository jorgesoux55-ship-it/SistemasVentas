@model List<SistemaVentas.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Gestión de Clientes</h2>
        <p class="text-muted small mb-0">Directorio de clientes y registro de compras</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold px-3 d-flex align-items-center gap-2">
        <i class="bi bi-person-plus-fill"></i>
        <span>Nuevo Cliente</span>
    </a>
</div>

<!-- Filtros de búsqueda -->
<div class="app-card mb-4">
    <div class="app-card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-9 col-12">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por nombre, apellido, teléfono o email..." />
                </div>
            </div>
            <div class="col-md-3 col-12 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-search"></i> Buscar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de clientes -->
<div class="app-card">
    <div class="table-responsive">
        <table class="table table-hover table-custom">
            <thead>
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Nombre Completo</th>
                    <th>Teléfono / Celular</th>
                    <th>Correo Electrónico</th>
                    <th class="text-center" style="width: 140px;">Ventas Registradas</th>
                    <th class="text-center" style="width: 140px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            No se encontraron clientes registrados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="text-muted fw-bold">#@c.Id</td>
                            <td>
                                <span class="fw-bold text-dark">@c.NombreCompleto</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(c.Telefono))
                                {
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-telephone me-1"></i>@c.Telefono
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">No registrado</span>
                                }
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(c.Email) ? "-" : c.Email)
                            </td>
                            <td class="text-center">
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1">
                                    @(c.Ventas?.Count ?? 0) ventas
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
