@model List<SistemaVentas.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <div class="small mb-1" style="color:var(--text-muted);">Directorio comercial</div>
        <h2 class="fw-bold mb-0" style="color:var(--text-primary);font-size:1.3rem;">Gestión de Clientes</h2>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-person-plus-fill"></i> Nuevo Cliente
    </a>
</div>

<!-- Filtros -->
<div class="sv-card mb-4">
    <div class="sv-card-body" style="padding:14px 20px;">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-9 col-12">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control"
                           placeholder="Buscar por nombre, teléfono o correo..." />
                </div>
            </div>
            <div class="col-md-3 col-12 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-search"></i> Buscar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla -->
<div class="sv-card">
    <div class="sv-card-header">
        <span><i class="bi bi-people-fill"></i> Directorio de Clientes</span>
        <span class="sv-pill sv-pill-blue">@(Model?.Count ?? 0) clientes</span>
    </div>
    <div class="table-responsive">
        <table class="sv-table">
            <thead>
                <tr>
                    <th style="width:60px;">ID</th>
                    <th>Nombre Completo</th>
                    <th>Teléfono</th>
                    <th>Correo Electrónico</th>
                    <th class="text-center" style="width:130px;">Compras</th>
                    <th class="text-center" style="width:120px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5" style="color:var(--text-muted);">
                            <i class="bi bi-people fs-2 d-block mb-2 opacity-25"></i>
                            No se encontraron clientes registrados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><span class="sv-pill sv-pill-gray">#@c.Id</span></td>
                            <td class="fw-semibold">@c.NombreCompleto</td>
                            <td>
                                @if (!string.IsNullOrEmpty(c.Telefono))
                                {
                                    <span class="sv-pill sv-pill-gray">
                                        <i class="bi bi-telephone"></i> @c.Telefono
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);" class="small">No registrado</span>
                                }
                            </td>
                            <td style="color:var(--text-muted);">
                                @(string.IsNullOrEmpty(c.Email) ? "—" : c.Email)
                            </td>
                            <td class="text-center">
                                <span class="sv-pill sv-pill-blue">@(c.Ventas?.Count ?? 0) ventas</span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
