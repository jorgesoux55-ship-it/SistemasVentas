@model SistemaVentas.Models.Cliente
@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8 col-12">
        <div class="app-card border-danger">
            <div class="app-card-header bg-danger-subtle text-danger">
                <span class="fs-5 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Eliminar Cliente</span>
            </div>
            <div class="app-card-body">
                <p class="lead mb-4">
                    ¿Está seguro de que desea eliminar al cliente <strong>@Model.NombreCompleto</strong>?
                </p>

                <div class="bg-light p-3 rounded mb-4">
                    <div class="row g-2">
                        <div class="col-6 text-muted">Teléfono / Celular:</div>
                        <div class="col-6 fw-semibold">@(Model.Telefono ?? "No registrado")</div>

                        <div class="col-6 text-muted">Correo electrónico:</div>
                        <div class="col-6 fw-semibold">@(Model.Email ?? "No registrado")</div>

                        <div class="col-6 text-muted">Ventas asociadas:</div>
                        <div class="col-6 fw-semibold">@(Model.Ventas?.Count ?? 0)</div>
                    </div>
                </div>

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger fw-semibold px-4">
                            <i class="bi bi-trash me-1"></i> Sí, Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
