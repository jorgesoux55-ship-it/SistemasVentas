@model List<SistemaVentas.Models.Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <div class="small mb-1" style="color:var(--text-muted);">Catálogo e inventario</div>
        <h2 class="fw-bold mb-0" style="color:var(--text-primary);font-size:1.3rem;">Gestión de Productos</h2>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Nuevo Producto
    </a>
</div>

<!-- Filtros -->
<div class="sv-card mb-4">
    <div class="sv-card-body" style="padding:14px 20px;">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-12">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control"
                           placeholder="Buscar producto por nombre..." />
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <select name="categoriaId" asp-items="@ViewBag.Categorias" class="form-select">
                    <option value="">— Todas las categorías —</option>
                </select>
            </div>
            <div class="col-md-2 col-sm-6 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-filter"></i> Filtrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla -->
<div class="sv-card">
    <div class="sv-card-header">
        <span><i class="bi bi-boxes"></i> Catálogo de Productos</span>
        <span class="sv-pill sv-pill-blue">@(Model?.Count ?? 0) productos</span>
    </div>
    <div class="table-responsive">
        <table class="sv-table">
            <thead>
                <tr>
                    <th style="width:60px;">ID</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th class="text-end" style="width:120px;">Precio (Bs)</th>
                    <th class="text-center" style="width:100px;">Stock</th>
                    <th class="text-center" style="width:100px;">Mínimo</th>
                    <th class="text-center" style="width:120px;">Estado</th>
                    <th class="text-center" style="width:120px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5" style="color:var(--text-muted);">
                            <i class="bi bi-box-seam fs-2 d-block mb-2 opacity-25"></i>
                            No se encontraron productos registrados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var p in Model)
                    {
                        var esAgotado   = p.Stock == 0;
                        var esStockBajo = p.Stock <= p.StockMinimo && !esAgotado;
                        <tr>
                            <td><span class="sv-pill sv-pill-gray">#@p.Id</span></td>
                            <td class="fw-semibold">@p.Nombre</td>
                            <td><span class="sv-pill sv-pill-cyan">@(p.Categoria?.Nombre ?? "—")</span></td>
                            <td class="text-end fw-bold" style="color:var(--text-primary);">Bs @p.Precio.ToString("N2")</td>
                            <td class="text-center fw-bold">
                                <span style="color:@(esAgotado ? "var(--danger)" : esStockBajo ? "var(--warning)" : "var(--success)");">
                                    @p.Stock
                                </span>
                            </td>
                            <td class="text-center" style="color:var(--text-muted);">@p.StockMinimo</td>
                            <td class="text-center">
                                @if (esAgotado)
                                {
                                    <span class="sv-pill sv-pill-red">Agotado</span>
                                }
                                else if (esStockBajo)
                                {
                                    <span class="sv-pill sv-pill-yellow">Stock Bajo</span>
                                }
                                else
                                {
                                    <span class="sv-pill sv-pill-green">Disponible</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
