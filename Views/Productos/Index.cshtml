@model List<SistemaVentas.Models.Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Gestión de Productos</h2>
        <p class="text-muted small mb-0">Catálogo de productos, precios y control de inventario</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold px-3 d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i>
        <span>Nuevo Producto</span>
    </a>
</div>

<!-- Filtros de búsqueda -->
<div class="app-card mb-4">
    <div class="app-card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-12">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por nombre de producto..." />
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <select name="categoriaId" asp-items="@ViewBag.Categorias" class="form-select">
                    <option value="">-- Todas las categorías --</option>
                </select>
            </div>
            <div class="col-md-2 col-sm-6 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-filter"></i> Filtrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de productos -->
<div class="app-card">
    <div class="table-responsive">
        <table class="table table-hover table-custom">
            <thead>
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th class="text-end" style="width: 130px;">Precio (Bs)</th>
                    <th class="text-center" style="width: 120px;">Stock</th>
                    <th class="text-center" style="width: 110px;">Mínimo</th>
                    <th class="text-center" style="width: 120px;">Estado</th>
                    <th class="text-center" style="width: 140px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-box-seam fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            No se encontraron productos registrados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var p in Model)
                    {
                        var esStockBajo = p.Stock <= p.StockMinimo;
                        var esAgotado = p.Stock == 0;
                        <tr>
                            <td class="text-muted fw-bold">#@p.Id</td>
                            <td>
                                <span class="fw-semibold text-dark">@p.Nombre</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(p.Categoria?.Nombre ?? "Sin categoría")
                                </span>
                            </td>
                            <td class="text-end fw-bold">Bs @p.Precio.ToString("N2")</td>
                            <td class="text-center fw-bold @(esAgotado ? "text-danger" : (esStockBajo ? "text-warning" : "text-dark"))">
                                @p.Stock
                            </td>
                            <td class="text-center text-muted">@p.StockMinimo</td>
                            <td class="text-center">
                                @if (esAgotado)
                                {
                                    <span class="badge bg-danger-subtle text-danger">Agotado</span>
                                }
                                else if (esStockBajo)
                                {
                                    <span class="badge bg-warning-subtle text-warning">Stock Bajo</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success">Disponible</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
