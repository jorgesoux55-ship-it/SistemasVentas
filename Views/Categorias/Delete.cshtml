@model SistemaVentas.Models.Categoria
@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8 col-12">
        <div class="app-card border-danger">
            <div class="app-card-header bg-danger-subtle text-danger">
                <span class="fs-5 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Eliminar Categoría</span>
            </div>
            <div class="app-card-body">
                <p class="lead mb-4">
                    ¿Está seguro de que desea eliminar la categoría <strong>@Model.Nombre</strong>?
                </p>

                <div asp-validation-summary="All" class="alert alert-danger mb-3" role="alert"></div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger fw-semibold px-4">
                            <i class="bi bi-trash me-1"></i> Sí, Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
