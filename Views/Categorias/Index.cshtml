@model List<SistemaVentas.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <div class="small mb-1" style="color:var(--text-muted);">Organización del catálogo</div>
        <h2 class="fw-bold mb-0" style="color:var(--text-primary);font-size:1.3rem;">Categorías de Productos</h2>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-tag-fill"></i> Nueva Categoría
    </a>
</div>

<div class="sv-card">
    <div class="sv-card-header">
        <span><i class="bi bi-tags-fill"></i> Listado de Categorías</span>
        <span class="sv-pill sv-pill-blue">@(Model?.Count ?? 0) categorías</span>
    </div>
    <div class="table-responsive">
        <table class="sv-table">
            <thead>
                <tr>
                    <th style="width:70px;">ID</th>
                    <th>Nombre de Categoría</th>
                    <th class="text-center" style="width:160px;">Productos Asociados</th>
                    <th class="text-center" style="width:140px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5" style="color:var(--text-muted);">
                            <i class="bi bi-tags fs-2 d-block mb-2 opacity-25"></i>
                            No hay categorías registradas en el sistema.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><span class="sv-pill sv-pill-gray">#@c.Id</span></td>
                            <td class="fw-semibold">@c.Nombre</td>
                            <td class="text-center">
                                <span class="sv-pill sv-pill-blue">@(c.Productos?.Count ?? 0) productos</span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
