@model List<SistemaVentas.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Categorías de Productos</h2>
        <p class="text-muted small mb-0">Organización y clasificación de artículos en el sistema</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold px-3 d-flex align-items-center gap-2">
        <i class="bi bi-tag-fill"></i>
        <span>Nueva Categoría</span>
    </a>
</div>

<div class="app-card">
    <div class="table-responsive">
        <table class="table table-hover table-custom">
            <thead>
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Nombre de Categoría</th>
                    <th class="text-center" style="width: 150px;">Productos Asociados</th>
                    <th class="text-center" style="width: 140px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <i class="bi bi-tags fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            No hay categorías registradas en el sistema.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="text-muted fw-bold">#@c.Id</td>
                            <td>
                                <span class="fw-bold text-dark">@c.Nombre</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1">
                                    @(c.Productos?.Count ?? 0) productos
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
