@model SistemaVentas.Models.Categoria

<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label fw-semibold"></label>
    <input asp-for="Nombre" class="form-control" placeholder="Ej: Bebidas, Limpieza, Lácteos..." autofocus />
    <span asp-validation-for="Nombre" class="text-danger small"></span>
</div>

<div class="d-flex justify-content-end gap-2 pt-3 border-top">
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    <button type="submit" class="btn btn-primary fw-semibold px-4">
        <i class="bi bi-save me-1"></i> Guardar
    </button>
</div>
