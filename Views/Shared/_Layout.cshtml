<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Sistema de Ventas") — SistemaVentas</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<!-- ── SIDEBAR ──────────────────────────────────────────────────── -->
<aside class="sv-sidebar" id="svSidebar">
    <!-- Logo / Brand -->
    <div class="sv-sidebar-brand">
        <div class="sv-brand-icon">
            <i class="bi bi-shop-window"></i>
        </div>
        <div class="sv-brand-text">
            <span class="sv-brand-name">SistemaVentas</span>
            <span class="sv-brand-sub">Panel Comercial</span>
        </div>
    </div>

    <!-- Main Navigation -->
    <nav class="sv-nav">
        <p class="sv-nav-label">Principal</p>
        <ul class="sv-nav-list">
            <li class="sv-nav-item">
                <a class="sv-nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="sv-nav-item">
                <a class="sv-nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Ventas" ? "active" : "")"
                   asp-controller="Ventas" asp-action="Index">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span>Ventas</span>
                    @if (ViewBag.VentasHoyCantidad != null && (int)ViewBag.VentasHoyCantidad > 0)
                    {
                        <span class="sv-badge">@ViewBag.VentasHoyCantidad</span>
                    }
                </a>
            </li>
            <li class="sv-nav-item">
                <a class="sv-nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Productos" ? "active" : "")"
                   asp-controller="Productos" asp-action="Index">
                    <i class="bi bi-boxes"></i>
                    <span>Productos</span>
                </a>
            </li>
            <li class="sv-nav-item">
                <a class="sv-nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Clientes" ? "active" : "")"
                   asp-controller="Clientes" asp-action="Index">
                    <i class="bi bi-people-fill"></i>
                    <span>Clientes</span>
                </a>
            </li>
            <li class="sv-nav-item">
                <a class="sv-nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categorias" ? "active" : "")"
                   asp-controller="Categorias" asp-action="Index">
                    <i class="bi bi-tags-fill"></i>
                    <span>Categorías</span>
                </a>
            </li>
        </ul>

        <p class="sv-nav-label">Análisis</p>
        <ul class="sv-nav-list">
            <li class="sv-nav-item">
                <a class="sv-nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reportes" ? "active" : "")"
                   asp-controller="Reportes" asp-action="Index">
                    <i class="bi bi-bar-chart-line-fill"></i>
                    <span>Reportes</span>
                </a>
            </li>
        </ul>

        @if (User.IsInRole("Administrador"))
        {
            <p class="sv-nav-label">Administración</p>
            <ul class="sv-nav-list">
                <li class="sv-nav-item">
                    <a class="sv-nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["Action"]?.ToString() == "Usuarios" ? "active" : "")"
                       asp-controller="Account" asp-action="Usuarios">
                        <i class="bi bi-person-gear"></i>
                        <span>Usuarios</span>
                    </a>
                </li>
            </ul>
        }
    </nav>

    <!-- Nueva Venta CTA -->
    <div class="sv-sidebar-cta">
        <a asp-controller="Ventas" asp-action="Create" class="sv-cta-btn">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Nueva Venta</span>
        </a>
    </div>
</aside>

<!-- ── OVERLAY mobile ──────────────────────────────────────────── -->
<div class="sv-overlay" id="svOverlay" onclick="closeSidebar()"></div>

<!-- ── MAIN CONTENT ──────────────────────────────────────────────── -->
<div class="sv-main" id="svMain">

    <!-- Top Bar -->
    <header class="sv-topbar">
        <div class="sv-topbar-left">
            <!-- Hamburger (mobile) -->
            <button class="sv-hamburger" id="svHamburger" onclick="toggleSidebar()">
                <i class="bi bi-list"></i>
            </button>
            <div class="sv-page-title">
                <h1 class="sv-page-h1">@(ViewData["Title"] ?? "Panel")</h1>
            </div>
        </div>
        <div class="sv-topbar-right">
            <!-- Hora actual -->
            <span class="sv-clock" id="svClock"></span>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="dropdown">
                    <button class="sv-user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="sv-user-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="sv-user-info d-none d-md-block">
                            <span class="sv-user-name">@User.Identity.Name</span>
                            <span class="sv-user-role">@(User.IsInRole("Administrador") ? "Administrador" : "Vendedor")</span>
                        </div>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end sv-dropdown shadow-lg">
                        <li class="px-3 py-2 border-bottom border-secondary mb-1">
                            <div class="d-flex align-items-center gap-2">
                                <div class="sv-user-avatar-sm">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div>
                                    <div class="text-white fw-semibold small">@User.Identity.Name</div>
                                    <div class="sv-role-badge">@(User.IsInRole("Administrador") ? "Administrador" : "Vendedor")</div>
                                </div>
                            </div>
                        </li>
                        <li>
                            <a class="dropdown-item sv-dropdown-item" asp-controller="Account" asp-action="Perfil">
                                <i class="bi bi-person-badge me-2"></i> Mi Perfil
                            </a>
                        </li>
                        <li><hr class="dropdown-divider border-secondary my-1"></li>
                        <li>
                            <a class="dropdown-item sv-dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                            </a>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="sv-login-btn">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                </a>
            }
        </div>
    </header>

    <!-- Alerts -->
    <div class="sv-alerts-wrap">
        @if (TempData["Success"] != null)
        {
            <div class="sv-alert sv-alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="sv-alert sv-alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
    </div>

    <!-- Page Content -->
    <main class="sv-content">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="sv-footer">
        <span>&copy; @DateTime.Now.Year SistemaVentas &bull; Todos los derechos reservados</span>
    </footer>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    // Reloj en vivo
    function updateClock() {
        const el = document.getElementById('svClock');
        if (!el) return;
        const now = new Date();
        el.textContent = now.toLocaleTimeString('es-BO', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 30000);

    // Sidebar mobile
    function toggleSidebar() {
        document.getElementById('svSidebar').classList.toggle('open');
        document.getElementById('svOverlay').classList.toggle('visible');
    }
    function closeSidebar() {
        document.getElementById('svSidebar').classList.remove('open');
        document.getElementById('svOverlay').classList.remove('visible');
    }
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
