@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center text-center py-5">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm p-5 rounded-4">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-slash-fill fs-1" style="font-size: 4rem !important;"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Acceso No Autorizado</h2>
            <p class="text-muted mb-4">No tiene los permisos suficientes para acceder a este recurso del sistema.</p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-house-door me-1"></i> Ir al Inicio
                </a>
            </div>
        </div>
    </div>
</div>
