code Views\Account\Login.cshtml@model SistemaVentas.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Sistema de Ventas</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            color: #1e293b;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            background: rgba(255, 255, 255, 0.98);
            border-radius: 1.25rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.1);
            overflow: hidden;
            transition: transform 0.2s ease;
        }

        .brand-header {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            padding: 2.25rem 2rem 1.75rem;
            text-align: center;
            color: #ffffff;
            position: relative;
        }

        .brand-icon {
            width: 64px;
            height: 64px;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(8px);
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 0.75rem;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
        }

        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            color: #059669;
        }

        .form-control:focus {
            border-color: #10b981;
            box-shadow: 0 0 0 0.25rem rgba(16, 185, 129, 0.2);
        }

        .btn-emerald {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            border: none;
            font-weight: 600;
            padding: 0.85rem;
            border-radius: 0.75rem;
            transition: all 0.2s ease;
        }

        .btn-emerald:hover {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.4);
        }

        .quick-badge {
            cursor: pointer;
            padding: 0.45rem 0.75rem;
            border-radius: 0.5rem;
            font-size: 0.8rem;
            font-weight: 600;
            border: 1px dashed #cbd5e1;
            background: #f8fafc;
            color: #475569;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .quick-badge:hover {
            border-color: #10b981;
            color: #059669;
            background: #ecfdf5;
            transform: scale(1.02);
        }
    </style>
</head>
<body>

    <div class="login-card">
        <!-- Encabezado con marca comercial -->
        <div class="brand-header">
            <div class="brand-icon">
                <i class="bi bi-shop-window"></i>
            </div>
            <h3 class="fw-bold mb-1 tracking-tight">Sistema de Ventas</h3>
            <p class="mb-0 text-white-50 small">Control comercial e inventario</p>
        </div>

        <div class="p-4 p-sm-5">
            <div class="mb-4 text-center">
                <h5 class="fw-bold text-dark mb-1">Bienvenido al Sistema</h5>
                <p class="text-muted small mb-0">Ingrese sus credenciales para acceder</p>
            </div>

            <!-- Notificaciones de TempData -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show small py-2 px-3 mb-3" role="alert">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show small py-2 px-3 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Login" method="post" id="loginForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3" role="alert"></div>

                <!-- Usuario -->
                <div class="form-floating mb-3">
                    <input asp-for="Username" class="form-control" id="floatingUsername" placeholder="nombre.usuario" required autofocus />
                    <label for="floatingUsername"><i class="bi bi-person me-1"></i> Usuario o Correo</label>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <!-- Contraseña con botón ver/ocultar -->
                <div class="position-relative mb-3">
                    <div class="form-floating">
                        <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="Contraseña" required />
                        <label for="floatingPassword"><i class="bi bi-shield-lock me-1"></i> Contraseña</label>
                    </div>
                    <button type="button" class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-muted text-decoration-none me-2" id="togglePassword" tabindex="-1">
                        <i class="bi bi-eye" id="togglePasswordIcon"></i>
                    </button>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <!-- Recordarme -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="Recordarme" class="form-check-input" type="checkbox" id="checkRecordar" />
                        <label class="form-check-label text-muted small" for="checkRecordar">
                            Recordar sesión
                        </label>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                        <i class="bi bi-shield-check"></i> Seguro
                    </span>
                </div>

                <!-- Botón de acceso -->
                <button type="submit" class="btn btn-emerald w-100 mb-4 shadow">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                </button>
            </form>

            <!-- Acceso Rápido para Pruebas / Demostración -->
            <div class="pt-3 border-top text-center">
                <span class="text-muted d-block small mb-2 fw-semibold">Acceso rápido con cuentas predeterminadas:</span>
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <button type="button" class="quick-badge" onclick="fillCredentials('admin', 'admin123')">
                        <i class="bi bi-person-fill-gear text-primary"></i>
                        <span>Admin (admin)</span>
                    </button>
                    <button type="button" class="quick-badge" onclick="fillCredentials('vendedor', 'vendedor123')">
                        <i class="bi bi-person-badge text-success"></i>
                        <span>Vendedor (vendedor)</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="bg-light py-3 px-4 text-center border-top">
            <small class="text-muted">&copy; @DateTime.Now.Year Sistema de Ventas &bull; Acceso Protegido</small>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Ver / ocultar contraseña
        const toggleBtn = document.getElementById('togglePassword');
        const passInput = document.getElementById('floatingPassword');
        const passIcon = document.getElementById('togglePasswordIcon');

        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                const isPassword = passInput.getAttribute('type') === 'password';
                passInput.setAttribute('type', isPassword ? 'text' : 'password');
                passIcon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        }

        // Función para autocompletar credenciales de prueba
        function fillCredentials(user, pass) {
            document.getElementById('floatingUsername').value = user;
            document.getElementById('floatingPassword').value = pass;
            document.getElementById('floatingUsername').focus();
        }
    </script>
</body>
</html>
