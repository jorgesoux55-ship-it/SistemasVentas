@{
    ViewData["Title"] = "Panel Principal";
    var stockBajo   = ViewBag.ProductosStockBajo as List<SistemaVentas.Models.Producto> ?? new();
    var ultimasVentas = ViewBag.UltimasVentas as List<SistemaVentas.Models.Venta> ?? new();
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <!-- Ingresos Totales -->
    <div class="col-xl-3 col-sm-6">
        <div class="sv-kpi" style="--kpi-color:#3b82f6;--kpi-bg:rgba(59,130,246,0.12);">
            <div>
                <div class="sv-kpi-label">Ingresos Totales</div>
                <div class="sv-kpi-value">Bs @(((decimal)ViewBag.TotalRecaudadoHistorico).ToString("N2"))</div>
                <div class="sv-kpi-sub">@ViewBag.TotalVentasHistorico ventas registradas</div>
            </div>
            <div class="sv-kpi-icon"><i class="bi bi-currency-dollar"></i></div>
        </div>
    </div>
    <!-- Ventas de Hoy -->
    <div class="col-xl-3 col-sm-6">
        <div class="sv-kpi" style="--kpi-color:#10b981;--kpi-bg:rgba(16,185,129,0.12);">
            <div>
                <div class="sv-kpi-label">Ventas de Hoy</div>
                <div class="sv-kpi-value">Bs @(((decimal)ViewBag.VentasHoyMonto).ToString("N2"))</div>
                <div class="sv-kpi-sub">@ViewBag.VentasHoyCantidad comprobantes hoy</div>
            </div>
            <div class="sv-kpi-icon" style="--kpi-color:#10b981;--kpi-bg:rgba(16,185,129,0.12);">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
        </div>
    </div>
    <!-- Productos -->
    <div class="col-xl-3 col-sm-6">
        <div class="sv-kpi" style="--kpi-color:#06b6d4;--kpi-bg:rgba(6,182,212,0.12);">
            <div>
                <div class="sv-kpi-label">Total Productos</div>
                <div class="sv-kpi-value">@ViewBag.TotalProductos</div>
                <div class="sv-kpi-sub">En @ViewBag.TotalCategorias categorías</div>
            </div>
            <div class="sv-kpi-icon"><i class="bi bi-box-seam-fill"></i></div>
        </div>
    </div>
    <!-- Clientes -->
    <div class="col-xl-3 col-sm-6">
        <div class="sv-kpi" style="--kpi-color:#f59e0b;--kpi-bg:rgba(245,158,11,0.12);">
            <div>
                <div class="sv-kpi-label">Clientes Activos</div>
                <div class="sv-kpi-value">@ViewBag.TotalClientes</div>
                <div class="sv-kpi-sub">En cartera comercial</div>
            </div>
            <div class="sv-kpi-icon"><i class="bi bi-people-fill"></i></div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Columna izquierda -->
    <div class="col-lg-8">

        <!-- Accesos rápidos -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-6">
                <a asp-controller="Ventas" asp-action="Create"
                   class="sv-card d-block text-decoration-none text-center p-3 hover-lift"
                   style="border-top: 2px solid #10b981;">
                    <i class="bi bi-cart3 fs-2 d-block mb-1" style="color:#10b981;"></i>
                    <div class="fw-bold small" style="color:var(--text-primary);">Nueva Venta</div>
                    <div class="small" style="color:var(--text-muted);">Registrar</div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a asp-controller="Productos" asp-action="Index"
                   class="sv-card d-block text-decoration-none text-center p-3 hover-lift"
                   style="border-top: 2px solid #3b82f6;">
                    <i class="bi bi-boxes fs-2 d-block mb-1" style="color:#3b82f6;"></i>
                    <div class="fw-bold small" style="color:var(--text-primary);">Inventario</div>
                    <div class="small" style="color:var(--text-muted);">Catálogo</div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a asp-controller="Clientes" asp-action="Index"
                   class="sv-card d-block text-decoration-none text-center p-3 hover-lift"
                   style="border-top: 2px solid #06b6d4;">
                    <i class="bi bi-person-lines-fill fs-2 d-block mb-1" style="color:#06b6d4;"></i>
                    <div class="fw-bold small" style="color:var(--text-primary);">Clientes</div>
                    <div class="small" style="color:var(--text-muted);">Cartera</div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a asp-controller="Reportes" asp-action="Index"
                   class="sv-card d-block text-decoration-none text-center p-3 hover-lift"
                   style="border-top: 2px solid #f59e0b;">
                    <i class="bi bi-bar-chart-fill fs-2 d-block mb-1" style="color:#f59e0b;"></i>
                    <div class="fw-bold small" style="color:var(--text-primary);">Reportes</div>
                    <div class="small" style="color:var(--text-muted);">Estadísticas</div>
                </a>
            </div>
        </div>

        <!-- Últimas Ventas -->
        <div class="sv-card">
            <div class="sv-card-header">
                <span><i class="bi bi-clock-history me-2"></i>Últimas Ventas Realizadas</span>
                <a asp-controller="Ventas" asp-action="Index" class="small text-decoration-none" style="color:var(--accent);">
                    Ver todas →
                </a>
            </div>
            <div class="table-responsive">
                <table class="sv-table">
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Comprobante</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!ultimasVentas.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4" style="color:var(--text-muted);">
                                    <i class="bi bi-receipt fs-2 d-block mb-2 opacity-25"></i>
                                    No hay ventas registradas aún.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var v in ultimasVentas)
                            {
                                <tr>
                                    <td><span class="sv-pill sv-pill-blue">#@v.Id</span></td>
                                    <td style="color:var(--text-muted);">@v.Fecha.ToString("dd/MM/yy HH:mm")</td>
                                    <td class="fw-semibold">@(v.Cliente?.NombreCompleto ?? "Mostrador")</td>
                                    <td class="text-end fw-bold" style="color:#10b981;">Bs @v.Total.ToString("N2")</td>
                                    <td class="text-center">
                                        <a asp-controller="Ventas" asp-action="Details" asp-route-id="@v.Id"
                                           class="btn btn-sm btn-outline-primary px-2 py-1">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Columna derecha: Alertas de Stock -->
    <div class="col-lg-4">
        <div class="sv-card h-100">
            <div class="sv-card-header">
                <span><i class="bi bi-exclamation-triangle-fill me-2" style="color:#f59e0b;"></i>Alertas de Stock Bajo</span>
                <span class="sv-pill sv-pill-yellow">@stockBajo.Count</span>
            </div>
            <div>
                @if (!stockBajo.Any())
                {
                    <div class="text-center py-5" style="color:var(--text-muted);">
                        <i class="bi bi-check-circle-fill fs-2 d-block mb-2" style="color:#10b981;"></i>
                        <span class="small">Todos los productos tienen stock óptimo.</span>
                    </div>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var p in stockBajo)
                        {
                            <li class="d-flex justify-content-between align-items-center px-4 py-3"
                                style="border-bottom:1px solid var(--border);">
                                <div>
                                    <div class="fw-semibold small" style="color:var(--text-primary);">@p.Nombre</div>
                                    <div class="small" style="color:var(--text-muted);">Mín: @p.StockMinimo u.</div>
                                </div>
                                <div class="text-end">
                                    <span class="sv-pill @(p.Stock == 0 ? "sv-pill-red" : "sv-pill-yellow")">
                                        @p.Stock u.
                                    </span>
                                    <a asp-controller="Productos" asp-action="Edit" asp-route-id="@p.Id"
                                       class="d-block small mt-1" style="color:var(--accent);">Reponer</a>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>