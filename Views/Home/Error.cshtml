@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center text-center py-5">
    <div class="col-md-6 col-12">
        <div class="text-danger mb-3">
            <i class="bi bi-exclamation-octagon fs-1"></i>
        </div>
        <h2 class="fw-bold">Ha ocurrido un problema</h2>
        <p class="text-muted">Se produjo un error al procesar su solicitud. Por favor intente nuevamente.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
            <i class="bi bi-house-door me-1"></i> Volver al Inicio
        </a>
    </div>
</div>
