@model SistemaVentas.Models.Venta
@{
    ViewData["Title"] = $"Comprobante de Venta #{Model.Id}";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9 col-12">
        <div class="d-flex justify-content-between align-items-center mb-3 no-print">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver a Ventas
            </a>
            <div class="d-flex gap-2">
                <button onclick="window.print()" class="btn btn-outline-dark btn-sm">
                    <i class="bi bi-printer me-1"></i> Imprimir Comprobante
                </button>
                <a asp-action="Create" class="btn btn-emerald btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> Nueva Venta
                </a>
            </div>
        </div>

        <div class="app-card shadow-sm p-4 p-md-5" id="ticket-print-area">
            <!-- Encabezado del Comprobante -->
            <div class="text-center border-bottom pb-3 mb-3">
                <h3 class="fw-bold mb-1 text-primary">SISTEMA DE VENTAS</h3>
                <p class="text-muted small mb-1">Comprobante de Venta Electrónico</p>
                <div class="badge bg-primary fs-6 px-3 py-1">N° @Model.Id.ToString("D6")</div>
            </div>

            <!-- Datos de la Venta y Cliente -->
            <div class="row g-2 mb-3 small">
                <div class="col-6">
                    <span class="text-muted d-block">Fecha de Emisión:</span>
                    <strong class="text-dark">@Model.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</strong>
                </div>
                <div class="col-6 text-end">
                    <span class="text-muted d-block">Estado:</span>
                    <span class="badge bg-success-subtle text-success">Completada</span>
                </div>
                <div class="col-12 mt-2 pt-2 border-top">
                    <span class="text-muted d-block">Cliente:</span>
                    <strong class="fs-6 text-dark">@(Model.Cliente?.NombreCompleto ?? "Cliente Mostrador")</strong>
                    @if (!string.IsNullOrEmpty(Model.Cliente?.Telefono))
                    {
                        <span class="text-muted ms-2">| Tel: @Model.Cliente.Telefono</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Cliente?.Email))
                    {
                        <span class="text-muted ms-2">| @Model.Cliente.Email</span>
                    }
                </div>
            </div>

            <!-- Tabla de Detalles -->
            <table class="table table-sm border-top border-bottom mt-3">
                <thead class="table-light">
                    <tr>
                        <th>Cant.</th>
                        <th>Descripción</th>
                        <th class="text-end">P. Unit</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Detalles)
                    {
                        <tr>
                            <td class="fw-bold">@item.Cantidad</td>
                            <td>
                                <div>@(item.Producto?.Nombre ?? "Producto")</div>
                                @if (item.Producto?.Categoria != null)
                                {
                                    <small class="text-muted">@item.Producto.Categoria.Nombre</small>
                                }
                            </td>
                            <td class="text-end">Bs @item.Precio.ToString("N2")</td>
                            <td class="text-end fw-semibold">Bs @item.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Resumen Financiero -->
            <div class="row justify-content-end mt-3">
                <div class="col-md-6 col-8">
                    <table class="table table-sm table-borderless">
                        <tr>
                            <td class="text-muted">Total Artículos:</td>
                            <td class="text-end fw-semibold">@Model.Detalles.Sum(d => d.Cantidad)</td>
                        </tr>
                        <tr class="border-top">
                            <td class="fs-5 fw-bold text-dark">TOTAL:</td>
                            <td class="fs-5 fw-bold text-end text-dark">Bs @Model.Total.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Efectivo Recibido:</td>
                            <td class="text-end">Bs @Model.Recibido.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Cambio / Vuelto:</td>
                            <td class="text-end text-success fw-bold">Bs @Model.Cambio.ToString("N2")</td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="text-center text-muted small mt-4 pt-3 border-top">
                <p class="mb-0">¡Gracias por su compra!</p>
                <small>Conserve este ticket como constancia de su transacción.</small>
            </div>
        </div>
    </div>
</div>
